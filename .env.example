# Copy to .env and fill in values to run live Banxa API tests.
# If these are not set, live API tests are skipped.
#
# Get your API key and partner code from the Banxa Partner Dashboard.
# Use sandbox for testing to avoid real transactions.

BANXA_API_KEY=your-api-key
BANXA_PARTNER=your-partner-code
BANXA_ENVIRONMENT=sandbox

# Optional: set to 1 or true to run buy/sell order-creation tests (sandbox only; creates test orders).
# BANXA_RUN_ORDER_TESTS=1
